"""Process relocation and compaction results."""

from .fragmentation import find_holes


def compact_processes(processes, total):
    ordered = sorted(processes, key=lambda item: item.start)
    moves = []
    next_address = 0
    for process in ordered:
        if process.start != next_address:
            moves.append({
                "pid": process.pid,
                "name": process.name,
                "size": process.size,
                "from": process.start,
                "to": next_address,
            })
        next_address += process.size

    holes_before = len(find_holes(processes, total))
    next_address = 0
    for process in ordered:
        process.start = next_address
        next_address += process.size
    holes_after = len(find_holes(processes, total))
    return {
        "moves": moves,
        "moved": len(moves),
        "copied_kb": sum(move["size"] for move in moves),
        "holes_before": holes_before,
        "holes_after": holes_after,
    }

